#!/bin/bash

# GE-Proton update script for Linux desktops
# Installs latest GE-Proton to Steam's compatibilitytools.d directory
#
# Usage Notes:
# - Ideal as a post-hook for apt-up or pac-up (e.g., /etc/apt-up.d/post.d/50-ge-proton or /etc/pac-up.d/post.d/50-ge-proton)
# - Set GE_PROTON_TARGET to override the install directory:
#   - In-script: GE_PROTON_TARGET="/custom/path" (uncomment below)
#   - Export: export GE_PROTON_TARGET="/home/user/.steam/steam/compatibilitytools.d"
#   - CLI: GE_PROTON_TARGET="/path" ./50-ge-proton
#   - With sudo: sudo GE_PROTON_TARGET="/path" ge-proton-updater
#     (sudo drops variables set before it)
# - Set GE_PROTON_ARCH to force a specific build (x86_64 or aarch64) regardless
#   of the detected CPU — useful under a translation layer (FEX-Emu, box64,
#   qemu-user, etc.) or to stage a build for another machine. Auto-detected if
#   unset; an unrecognized CPU falls back to x86_64 with a warning.
# - When run as root (e.g. as a hook), the script switches to the user who owns
#   the target Steam directory before doing anything, so root never writes
#   into a user's home.
# - Use --force-root to allow installation to /root/.steam/... as root
# - Use --debug for verbose output
# - Use --dry-run to check for updates and report what would happen without
#   downloading or changing anything (also honoured via IS_DRY_RUN=true,
#   which apt-up/pac-up export automatically when run with --dry-run)
# - Designed for apt-up/pac-up hooks or standalone use
#
# This script uses static directory names (GE-Proton-Latest, GE-Proton-Previous)
# with customized compatibilitytool.vdf files so that Steam doesn't require a
# restart to pick up new GE-Proton versions after initial setup.

set -euo pipefail  # Exit on errors, unset vars, and pipe failures

# GitHub API URL for latest GE-Proton release
GH_API_URL="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"

# Uncomment to set a default GE_PROTON_TARGET (optional)
# GE_PROTON_TARGET="/custom/path/to/compatibilitytools.d"

# Static directory and display names
LATEST_DIR="GE-Proton-Latest"
PREVIOUS_DIR="GE-Proton-Previous"
LATEST_INTERNAL="GE-Proton-Latest"
PREVIOUS_INTERNAL="GE-Proton-Previous"
LATEST_DISPLAY_PREFIX="Proton GE Latest"
PREVIOUS_DISPLAY_PREFIX="Proton GE Previous"
VERSION_FILE=".ge-proton-version"
STAGING_PREFIX=".ge-proton-staging"

# Minimum files expected after extraction (configurable via env var)
MIN_FILES=${MIN_FILES:-5}

# Network settings: give up on a connection that doesn't open within 15s, or a
# download that stays under 10 KB/s for a minute. A stalled transfer must never
# hang the parent update run.
CURL_NET=(--connect-timeout 15 --speed-limit 10240 --speed-time 60 --retry 2 --retry-delay 5)

DEBUG=0
FORCE_ROOT=0
DRY_RUN="${IS_DRY_RUN:-false}"

# Colors only when stderr (where all output goes) is a terminal, so cron mail
# and logs stay plain.
if [[ -t 2 ]]; then
	RED='\033[0;31m'
	GREEN='\033[0;32m'
	YELLOW='\033[0;33m'
	NC='\033[0m'
else
	RED='' GREEN='' YELLOW='' NC=''
fi

log() { printf '%b%s%b\n' "${2:-}" "$1" "${NC}" >&2; }

debug_log() {
	if [[ "$DEBUG" -eq 1 ]]; then
		log "DEBUG: $1" "$YELLOW"
	fi
}

show_help() {
	cat >&2 << 'EOF'
ge-proton-updater - install and update GE-Proton for native Steam

Usage: ge-proton-updater [--dry-run] [--debug] [--force-root]

  --dry-run     Report what would happen without downloading or changing anything
  --debug       Verbose output
  --force-root  Allow installing into root's own Steam directory

Environment:
  GE_PROTON_TARGET  Install into this compatibilitytools.d directory
  GE_PROTON_ARCH    Force the x86_64 or aarch64 build
  IS_DRY_RUN=true   Same as --dry-run (exported by apt-up/pac-up)
EOF
}

# --- Ownership and privileges ---

# Prints the user who effectively controls a path: the owner of the nearest
# non-root-owned directory on the way up from it (the path itself may not exist
# yet). A root-owned directory inside someone's home still counts as theirs,
# since they can rename it out of the way. Prints "root" for system paths.
path_controller() {
	local p="$1" owner
	while [[ -n "$p" && "$p" != "/" ]]; do
		if [[ -e "$p" ]]; then
			owner=$(stat -c %U "$p" 2>/dev/null || echo root)
			if [[ "$owner" != "root" ]]; then
				echo "$owner"
				return 0
			fi
		fi
		p=$(dirname "$p")
	done
	echo root
}

# Re-runs this script as $1 with the same arguments and settings, so every
# file in that user's Steam directory is created and replaced by that user.
drop_privileges() {
	local owner="$1"
	shift
	local self
	self=$(readlink -f "${BASH_SOURCE[0]}")

	if [[ -n "${GE_PROTON_DROPPED:-}" ]]; then
		log "Error: Still running as root after switching to $owner; refusing to continue" "$RED"
		exit 1
	fi
	export GE_PROTON_DROPPED=1 IS_DRY_RUN="$DRY_RUN" MIN_FILES
	if [[ -n "${GE_PROTON_TARGET:-}" ]]; then export GE_PROTON_TARGET; fi
	if [[ -n "${GE_PROTON_ARCH:-}" ]]; then export GE_PROTON_ARCH; fi

	# The caller's working directory (often /root) and temp directory (e.g.
	# /tmp/user/0 from libpam-tmpdir) may not be accessible to the user.
	cd /
	unset TMPDIR TMP TEMP TEMPDIR
	debug_log "Switching to user $owner to run $self"
	if command -v runuser >/dev/null 2>&1; then
		if ! runuser -u "$owner" -- test -r "$self"; then
			log "Error: $owner can't read $self; make it world-readable (chmod 755)" "$RED"
			exit 1
		fi
		exec runuser -u "$owner" -- /bin/bash "$self" "$@"
	elif command -v sudo >/dev/null 2>&1; then
		exec sudo -u "$owner" \
			--preserve-env=GE_PROTON_DROPPED,IS_DRY_RUN,MIN_FILES,GE_PROTON_TARGET,GE_PROTON_ARCH \
			-- /bin/bash "$self" "$@"
	else
		log "Error: Need runuser or sudo to switch to user $owner" "$RED"
		exit 1
	fi
}

# --- Steam detection ---

# Prints the compatibilitytools.d directory for the current user's native Steam,
# creating it (unless dry-run) if Steam is installed but the directory isn't.
# Returns 1 if there is no native Steam installation, 2 on error.
find_steam_dir() {
	local home_dir base compat_dir
	home_dir=$(getent passwd "$(id -un)" | cut -d: -f6) || home_dir="${HOME:-}"
	local steam_base_paths=(
		"$home_dir/.steam/steam"              # Most common native Steam (symlink)
		"$home_dir/.local/share/Steam"        # Native Steam's actual data directory
		"$home_dir/.steam"                    # Older native setups
		# Flatpak Steam is intentionally excluded. Upstream GE-Proton tarballs
		# include pressure-vessel, which fails inside Flatpak's existing sandbox.
	)

	for base in "${steam_base_paths[@]}"; do
		if [[ -d "$base/compatibilitytools.d" ]]; then
			echo "$base/compatibilitytools.d"
			return 0
		fi
	done

	for base in "${steam_base_paths[@]}"; do
		if [[ -d "$base/steamapps" ]]; then
			compat_dir="$base/compatibilitytools.d"
			if [[ "$DRY_RUN" != "true" ]]; then
				mkdir -p "$compat_dir" || {
					log "Error: Cannot create $compat_dir" "$RED"
					return 2
				}
			fi
			echo "$compat_dir"
			return 0
		fi
	done
	return 1
}

# --- Release lookup ---

# Resolve which GE-Proton build to fetch, as an ordered list of asset-name
# suffixes to try.
#
# Upstream's asset naming has moved more than once: pre-11 releases were
# x86_64-only and unsuffixed (GE-Proton10-30.tar.gz); GE-Proton11-1 added
# aarch64 builds with an "-aarch64" suffix while x86_64 stayed bare; and by
# GE-Proton11-5 the x86_64 assets carry an explicit "-x86_64" suffix
# (GE-Proton11-5-x86_64.tar.gz). Hard-coding any one of those spellings breaks
# the day it changes again, so try the known spellings in order and take the
# first that actually exists in the release. Matching is still by exact
# filename per candidate, so we never grab both architectures at once.
#
# Resolution order for which architecture we want:
#   1. GE_PROTON_ARCH override, if set (x86_64/amd64 or aarch64/arm64). An
#      unrecognized override value is treated as a user error (returns 1).
#   2. Auto-detected uname -m.
#   3. An unrecognized CPU falls back to x86_64 with a warning rather than
#      bailing — someone running this on an exotic host is most likely using a
#      translation layer (FEX-Emu, box64, qemu-user, ...), which almost always
#      translates x86_64. Set GE_PROTON_ARCH to choose explicitly.
#
# Populates the global ARCH_SUFFIXES array (an empty element means "no suffix").
ARCH_SUFFIXES=()
resolve_arch_suffixes() {
	local requested="${GE_PROTON_ARCH:-$(uname -m)}"

	case "$requested" in
		x86_64|amd64)  ARCH_SUFFIXES=("-x86_64" "-amd64" "") ;;
		aarch64|arm64) ARCH_SUFFIXES=("-aarch64" "-arm64") ;;
		*)
			if [[ -n "${GE_PROTON_ARCH:-}" ]]; then
				log "Error: Unrecognized GE_PROTON_ARCH '$GE_PROTON_ARCH' (expected x86_64 or aarch64)." "$RED"
				return 1
			fi
			log "Warning: Unsupported CPU architecture '$requested'; assuming x86_64." "$YELLOW"
			log "Set GE_PROTON_ARCH=aarch64 (or x86_64) to choose the build explicitly." "$YELLOW"
			ARCH_SUFFIXES=("-x86_64" "-amd64" "")
			;;
	esac
}

# Sets globals: version, tarball_url, checksum_url
get_latest_release() {
	local compat_dir_param="$1"
	local release_info http_code
	debug_log "Fetching latest release info from $GH_API_URL"

	http_code=$(curl -sS -L --connect-timeout 15 --max-time 60 -o "$TMP_DIR/release.json" \
		-w "%{http_code}" "$GH_API_URL" 2>/dev/null) || http_code="000"
	debug_log "HTTP response code: $http_code"

	if [[ "$http_code" == "000" ]]; then
		log "Error: Could not reach the GitHub API (network down or timed out)" "$RED"
		exit 1
	fi
	release_info=$(cat "$TMP_DIR/release.json" 2>/dev/null || true)
	debug_log "First 200 chars of response: ${release_info:0:200}"

	if [[ "$http_code" -eq 403 || "$http_code" -eq 429 ]]; then
		log "Error: GitHub API rate limit exceeded; try again later" "$RED"
		exit 1
	elif [[ "$http_code" -ne 200 ]]; then
		log "Error: GitHub API request failed with HTTP $http_code" "$RED"
		exit 1
	fi

	if ! resolve_arch_suffixes; then
		exit 1
	fi
	debug_log "Arch: uname -m=$(uname -m), GE_PROTON_ARCH='${GE_PROTON_ARCH:-<unset>}'"
	debug_log "Asset suffix candidates (in order): [${ARCH_SUFFIXES[*]}]"

	local asset_urls
	if command -v jq >/dev/null 2>&1; then
		debug_log "Using jq for JSON parsing"
		version=$(jq -r '.tag_name // empty' <<< "$release_info" 2>/dev/null || true)
		asset_urls=$(jq -r '.assets[].browser_download_url' <<< "$release_info" 2>/dev/null || true)
	else
		debug_log "Using grep for JSON parsing"
		version=$(grep -o '"tag_name": *"[^"]*"' <<< "$release_info" | head -n1 | cut -d'"' -f4 || true)
		asset_urls=$(grep -o '"browser_download_url": *"[^"]*"' <<< "$release_info" | cut -d'"' -f4 || true)
	fi

	if [[ -z "$version" ]]; then
		log "Error: Failed to parse version from GitHub API" "$RED"
		debug_log "Full API response: $release_info"
		exit 1
	fi
	debug_log "Parsed version: $version"
	debug_log "Assets found in release: $(grep -c . <<< "$asset_urls" || true)"

	tarball_url=""
	checksum_url=""
	local suffix want_tarball want_checksum candidate_tarball candidate_checksum
	for suffix in "${ARCH_SUFFIXES[@]}"; do
		want_tarball="${version}${suffix}.tar.gz"
		want_checksum="${version}${suffix}.sha512sum"
		# Leading slash anchors the match to the filename component of the URL,
		# so the bare "GE-Proton11-5.tar.gz" candidate can't match the suffixed
		# "GE-Proton11-5-x86_64.tar.gz".
		candidate_tarball=$(grep -F -- "/$want_tarball" <<< "$asset_urls" | head -n1 || true)
		candidate_checksum=$(grep -F -- "/$want_checksum" <<< "$asset_urls" | head -n1 || true)
		if [[ -n "$candidate_tarball" && -n "$candidate_checksum" ]]; then
			tarball_url="$candidate_tarball"
			checksum_url="$candidate_checksum"
			debug_log "Matched asset suffix '${suffix:-<none>}': $want_tarball"
			break
		fi
		debug_log "No complete match for suffix '${suffix:-<none>}'"
	done

	# Distinguish a release whose assets are still uploading (wait and retry)
	# from one whose assets have names we don't recognize (upstream renamed
	# something and this script needs a new candidate suffix).
	if [[ -z "$tarball_url" || -z "$checksum_url" ]]; then
		local any_tarball url
		any_tarball=$(grep -F -- '.tar.gz' <<< "$asset_urls" | head -n1 || true)

		if [[ -n "$any_tarball" ]]; then
			log "Error: Release $version has assets, but none match the expected names for this architecture" "$RED"
			for suffix in "${ARCH_SUFFIXES[@]}"; do
				log "  Looked for: ${version}${suffix}.tar.gz + ${version}${suffix}.sha512sum" "$YELLOW"
			done
			log "  Assets actually present:" "$YELLOW"
			while IFS= read -r url; do
				[[ -z "$url" ]] && continue
				log "    ${url##*/}" "$YELLOW"
			done <<< "$asset_urls"
			log "Upstream has likely renamed their release assets; this script needs updating." "$RED"
			exit 1
		fi

		log "Warning: Latest release ($version) doesn't have binary assets available yet" "$YELLOW"
		log "This usually happens when a release is just published but assets are still being uploaded" "$YELLOW"
		log "Please try again in a few minutes, or check: https://github.com/GloriousEggroll/proton-ge-custom/releases/latest" "$YELLOW"
		if [[ "$(read_installed_version "$compat_dir_param/$LATEST_DIR")" == "$version" ]]; then
			log "$version is already installed as $LATEST_DISPLAY_PREFIX, nothing to do" "$GREEN"
			exit 0
		fi
		log "Assets not available for download yet, exiting" "$RED"
		exit 1
	fi

	log "Latest version: $version" "$NC"
	debug_log "Tarball URL: $tarball_url"
	debug_log "Checksum URL: $checksum_url"
}

# --- Download and install ---

# Downloads the tarball and checksum into TMP_DIR and verifies them.
download_and_verify() {
	local tarball_name="${tarball_url##*/}" checksum_name="${checksum_url##*/}"
	local -a progress=(-sS)
	# A progress bar only on a terminal; under cron it would be thousands of lines.
	if [[ -t 2 ]]; then
		progress=(--progress-bar)
	fi

	log "Downloading $tarball_name..." "$NC"
	curl -fL "${CURL_NET[@]}" "${progress[@]}" -o "$TMP_DIR/$tarball_name" "$tarball_url" || {
		log "Error: Download of $tarball_name failed" "$RED"
		exit 1
	}
	curl -fsSL "${CURL_NET[@]}" -o "$TMP_DIR/$checksum_name" "$checksum_url" || {
		log "Error: Download of $checksum_name failed" "$RED"
		exit 1
	}

	log "Verifying checksum..." "$NC"
	debug_log "Checksum file content: $(cat "$TMP_DIR/$checksum_name")"
	if (cd "$TMP_DIR" && sha512sum -c "$checksum_name" >/dev/null 2>&1); then
		log "Checksum verification passed" "$GREEN"
	else
		log "Error: Checksum verification failed" "$RED"
		if [[ "$DEBUG" -eq 1 ]]; then
			(cd "$TMP_DIR" && sha512sum -c "$checksum_name") || true
		fi
		exit 1
	fi
	TARBALL_PATH="$TMP_DIR/$tarball_name"
}

read_installed_version() {
	local dir="$1"
	if [[ -f "$dir/$VERSION_FILE" ]]; then
		cat "$dir/$VERSION_FILE" 2>/dev/null || true
	fi
}

# Writes a compatibilitytool.vdf with custom names
write_vdf() {
	local target_dir="$1" internal_name="$2" display_name="$3"
	local vdf_path="$target_dir/compatibilitytool.vdf"

	debug_log "Writing VDF: internal=$internal_name display=$display_name path=$vdf_path"
	rm -f "$vdf_path"
	cat > "$vdf_path" <<VDFEOF
"compatibilitytools"
{
  "compat_tools"
  {
    "$internal_name" // Internal name of this tool
    {
      // Can register this tool with Steam in two ways:
      //
      // - The tool can be placed as a subdirectory in compatibilitytools.d, in which case this
      //   should be '.'
      //
      // - This manifest can be placed directly in compatibilitytools.d, in which case this should
      //   be the relative or absolute path to the tool's dist directory.
      "install_path" "."

      // For this template, we're going to substitute the display_name key in here, e.g.:
      "display_name" "$display_name"

      "from_oslist"  "windows"
      "to_oslist"    "linux"
    }
  }
}
VDFEOF
}

# Installs GE-Proton with static naming and version rotation.
install_ge_proton() {
	local target_dir="$1" version="$2"
	local latest_path="$target_dir/$LATEST_DIR"
	local previous_path="$target_dir/$PREVIOUS_DIR"

	# Extract into a staging directory on the SAME filesystem as the target,
	# BEFORE any rotation: a failed or interrupted extraction never touches the
	# existing Latest/Previous, and the final swap is a rename.
	find "$target_dir" -mindepth 1 -maxdepth 1 -name "${STAGING_PREFIX}.*" -exec rm -rf {} + 2>/dev/null || true
	STAGING_DIR="$target_dir/${STAGING_PREFIX}.$$"
	mkdir -p "$STAGING_DIR" || {
		log "Error: Cannot create staging directory $STAGING_DIR" "$RED"
		exit 1
	}

	log "Extracting $version to $LATEST_DIR..." "$NC"
	# The checksum already proved the tarball is exactly what upstream published,
	# so a single extraction pass is all the reading it needs.
	local extract_output
	extract_output=$(tar -xzf "$TARBALL_PATH" -C "$STAGING_DIR" 2>&1) || {
		log "Error: Extraction failed" "$RED"
		debug_log "Extraction output: $extract_output"
		exit 1
	}

	# The tarball holds a single top-level directory; its name differs between
	# architectures, so take whatever was extracted rather than assuming it.
	local -a extracted=()
	mapfile -t extracted < <(find "$STAGING_DIR" -mindepth 1 -maxdepth 1)
	if [[ "${#extracted[@]}" -ne 1 || ! -d "${extracted[0]}" ]]; then
		log "Error: Expected one top-level directory in the tarball, found ${#extracted[@]} entries" "$RED"
		exit 1
	fi
	local staged_path="${extracted[0]}"
	debug_log "Tarball top-level directory: ${staged_path##*/}"

	local file_count
	file_count=$(find "$staged_path" -type f | wc -l)
	debug_log "Files extracted: $file_count"
	if [[ "$file_count" -lt "$MIN_FILES" ]]; then
		log "Warning: Extraction produced fewer files than expected ($file_count < $MIN_FILES)" "$YELLOW"
	fi

	# Now that a good build is staged, rotate Latest → Previous
	local current_latest_version
	current_latest_version=$(read_installed_version "$latest_path")
	debug_log "Current Latest version: ${current_latest_version:-none}"

	if [[ -d "$latest_path" && -n "$current_latest_version" ]]; then
		log "Rotating $LATEST_DIR ($current_latest_version) → $PREVIOUS_DIR..." "$NC"
		if [[ -e "$previous_path" ]]; then
			rm -rf "$previous_path" || log "Warning: Failed to remove $previous_path" "$YELLOW"
		fi
		mv "$latest_path" "$previous_path" || {
			log "Error: Failed to rotate $LATEST_DIR → $PREVIOUS_DIR" "$RED"
			exit 1
		}
		write_vdf "$previous_path" "$PREVIOUS_INTERNAL" "$PREVIOUS_DISPLAY_PREFIX"
		log "Previous version: $current_latest_version" "$GREEN"
	else
		# No usable Latest to rotate; clear any stale/partial Latest so the swap
		# below creates a clean directory instead of nesting inside it.
		rm -rf "$latest_path"
	fi

	# Swap the staged build into place (same-filesystem rename)
	mv "$staged_path" "$latest_path" || {
		log "Error: Failed to move staged build into $latest_path" "$RED"
		exit 1
	}
	rm -rf "$STAGING_DIR"
	STAGING_DIR=""

	write_vdf "$latest_path" "$LATEST_INTERNAL" "$LATEST_DISPLAY_PREFIX"
	echo "$version" > "$latest_path/$VERSION_FILE"
	debug_log "Wrote version state file: $version"

	log "$version installed as '$LATEST_DISPLAY_PREFIX'!" "$GREEN"
	if [[ -z "$current_latest_version" ]]; then
		log "==> Note: Steam requires a restart for the initial setup of $LATEST_DISPLAY_PREFIX." "$GREEN"
		log "In Steam: Steam > Settings > Compatibility > Set 'Default compatibility tool' to '$LATEST_DISPLAY_PREFIX'." "$GREEN"
		log "Future updates will be picked up automatically without restarting Steam." "$GREEN"
	else
		log "==> Updated in-place. No Steam restart required." "$GREEN"
	fi
}

# --- Legacy cleanup ---

# Internal tool names Steam currently has games (or the default) mapped to.
# Returns 1 if Steam's config can't be read.
mapped_compat_tools() {
	local config="$1/config/config.vdf"
	[[ -r "$config" ]] || return 1
	awk '
		/"CompatToolMapping"/ { inmap = 1; depth = 0; next }
		inmap && /\{/ { depth++ }
		inmap && /\}/ { depth--; if (depth <= 0) inmap = 0 }
		inmap && match($0, /"name"[[:space:]]+"[^"]*"/) {
			s = substr($0, RSTART, RLENGTH)
			sub(/^"name"[[:space:]]+"/, "", s); sub(/"$/, "", s)
			if (s != "") print s
		}
	' "$config"
}

# Internal name declared in a tool directory's compatibilitytool.vdf
tool_internal_name() {
	awk '
		/"compat_tools"/ { found = 1; next }
		found && match($0, /"[^"]+"/) { print substr($0, RSTART + 1, RLENGTH - 2); exit }
	' "$1/compatibilitytool.vdf" 2>/dev/null || true
}

# Older versions of this script installed every release into its own versioned
# directory (GE-Proton10-27, ...). On the move to GE-Proton-Latest those are
# removed once. Tools installed by ProtonUp-Qt or by hand use the same naming,
# so anything a game or the default is still mapped to in Steam is kept, and if
# Steam's config can't be read nothing is removed at all.
cleanup_legacy_versions() {
	local target_dir="$1" dir name internal m in_use
	local -a legacy=() mapped=()

	while IFS= read -r dir; do
		name="${dir##*/}"
		if [[ "$name" =~ ^GE-Proton[0-9] ]]; then
			legacy+=("$dir")
		fi
	done < <(find "$target_dir" -mindepth 1 -maxdepth 1 -type d -name 'GE-Proton*' 2>/dev/null | LC_ALL=C sort)

	if [[ "${#legacy[@]}" -eq 0 ]]; then
		debug_log "No legacy versioned directories found."
		return 0
	fi
	if [[ ! -r "$(dirname "$target_dir")/config/config.vdf" ]]; then
		log "Leaving older GE-Proton versions in place (couldn't read Steam's config to see which are in use):" "$YELLOW"
		for dir in "${legacy[@]}"; do log "  ${dir##*/}" "$YELLOW"; done
		return 0
	fi
	mapfile -t mapped < <(mapped_compat_tools "$(dirname "$target_dir")" || true)

	for dir in "${legacy[@]}"; do
		name="${dir##*/}"
		internal=$(tool_internal_name "$dir")
		in_use=false
		for m in "${mapped[@]}"; do
			if [[ "$m" == "$name" || "$m" == "${internal:-$name}" ]]; then
				in_use=true
				break
			fi
		done
		if [[ "$in_use" == "true" ]]; then
			log "Keeping $name (selected for a game or as the default in Steam)" "$NC"
			continue
		fi
		if [[ "$DRY_RUN" == "true" ]]; then
			log "[DRY-RUN] Would remove older version $name" "$NC"
		else
			log "Removing older version $name..." "$NC"
			rm -rf "$dir" || log "Warning: Failed to remove $dir" "$YELLOW"
		fi
	done
}

# --- Main ---

for arg in "$@"; do
	case "$arg" in
		--force-root) FORCE_ROOT=1 ;;
		--debug) DEBUG=1 ;;
		--dry-run) DRY_RUN=true ;;
		--help|-h) show_help; exit 0 ;;
		*) log "Warning: Ignoring unknown argument '$arg'" "$YELLOW" ;;
	esac
done

if [[ "$DEBUG" -eq 1 ]]; then
	debug_log "System info: $(uname -a)"
	debug_log "Running as: $(id -un) (EUID $EUID), SUDO_USER=${SUDO_USER:-<unset>}"
fi

if [[ -n "${GE_PROTON_TARGET:-}" && "$GE_PROTON_TARGET" != /* ]]; then
	log "Error: GE_PROTON_TARGET must be an absolute path (got '$GE_PROTON_TARGET')" "$RED"
	exit 1
fi

# As root, work out whose Steam directory this is and become that user first.
if [[ "$EUID" -eq 0 ]]; then
	if [[ -n "${GE_PROTON_TARGET:-}" ]]; then
		OWNER=$(path_controller "$GE_PROTON_TARGET")
	elif [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
		OWNER="$SUDO_USER"
	elif [[ "$FORCE_ROOT" -eq 1 ]]; then
		OWNER=root
		log "Installing to root's Steam dir with --force-root" "$NC"
	else
		log "Skipping GE-Proton update: running as root with no sudo user, GE_PROTON_TARGET, or --force-root" "$YELLOW"
		exit 0
	fi
	if [[ "$OWNER" != "root" ]]; then
		drop_privileges "$OWNER" "$@"
	fi
fi

log "Checking for GE-Proton updates..." "$NC"

if [[ -n "${GE_PROTON_TARGET:-}" ]]; then
	COMPAT_DIR="$GE_PROTON_TARGET"
	log "Using overridden Steam directory: $COMPAT_DIR" "$NC"
	if [[ ! -d "$COMPAT_DIR" && "$DRY_RUN" != "true" ]]; then
		mkdir -p "$COMPAT_DIR" || {
			log "Error: Cannot create $COMPAT_DIR as $(id -un)" "$RED"
			exit 1
		}
	fi
else
	rc=0
	COMPAT_DIR=$(find_steam_dir) || rc=$?
	if [[ "$rc" -eq 2 ]]; then
		exit 1
	elif [[ "$rc" -ne 0 ]]; then
		home_dir=$(getent passwd "$(id -un)" | cut -d: -f6) || home_dir="${HOME:-}"
		if [[ -d "$home_dir/.var/app/com.valvesoftware.Steam" ]]; then
			log "Only Flatpak Steam found for $(id -un). This script can't install into it; use:" "$YELLOW"
			log "  flatpak install com.valvesoftware.Steam.CompatibilityTool.Proton-GE" "$YELLOW"
		else
			log "No native Steam installation found for $(id -un); nothing to do." "$NC"
		fi
		exit 0
	fi
	log "Using Steam directory: $COMPAT_DIR" "$NC"
fi

if [[ -d "$COMPAT_DIR" && "$DRY_RUN" != "true" && ! -w "$COMPAT_DIR" ]]; then
	log "Error: $COMPAT_DIR isn't writable by $(id -un) (owned by $(stat -c %U "$COMPAT_DIR"))" "$RED"
	log "Fix with: sudo chown -R $(id -un): $COMPAT_DIR" "$RED"
	exit 1
fi

TMP_BASE="${TMPDIR:-/tmp}"
if [[ ! -d "$TMP_BASE" || ! -w "$TMP_BASE" ]]; then
	debug_log "TMPDIR $TMP_BASE isn't writable, using /tmp"
	TMP_BASE=/tmp
fi
TMP_DIR=$(mktemp -d "$TMP_BASE/ge-proton-update.XXXXXX")
STAGING_DIR=""
trap 'rm -rf "$TMP_DIR"; if [[ -n "$STAGING_DIR" ]]; then rm -rf "$STAGING_DIR"; fi' EXIT
debug_log "Using temp directory: $TMP_DIR"

get_latest_release "$COMPAT_DIR"

INSTALLED_VERSION=$(read_installed_version "$COMPAT_DIR/$LATEST_DIR")
debug_log "Installed version (from state file): ${INSTALLED_VERSION:-none}"

if [[ "$INSTALLED_VERSION" == "$version" ]]; then
	log "$version already installed as $LATEST_DISPLAY_PREFIX" "$NC"
	log "No update needed." "$NC"
elif [[ "$DRY_RUN" == "true" ]]; then
	if [[ -n "$INSTALLED_VERSION" ]]; then
		log "[DRY-RUN] Would update GE-Proton: $INSTALLED_VERSION → $version" "$NC"
	else
		log "[DRY-RUN] Would install GE-Proton $version (first install)" "$NC"
		cleanup_legacy_versions "$COMPAT_DIR"
	fi
else
	download_and_verify
	install_ge_proton "$COMPAT_DIR" "$version"
	# One-time move from the old one-directory-per-version layout.
	if [[ -z "$INSTALLED_VERSION" ]]; then
		cleanup_legacy_versions "$COMPAT_DIR"
	fi
fi

log "Done!" "$NC"
exit 0
